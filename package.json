{
  "name": "madar-academy",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite web --host 127.0.0.1 --port 8080",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "preview": "vite preview web --outDir ../dist --host 127.0.0.1 --port 8080",
    "test": "node --test backend/test/*.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "format": "prettier --write web backend/*.mjs backend/test scripts docs/*.md README.md template.yaml",
    "test:offline": "node scripts/build-preview.mjs && node scripts/test-offline.mjs"
  },
  "dependencies": {
    "oidc-client-ts": "^3.4.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "vite": "^7.3.1"
  }
}
